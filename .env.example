# Server-only Supabase project values. Never expose the service role key in NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_BUCKET=cloudbox

# Recommended for production distributed rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile anti-bot (configure site/secret keys before enabling in code)
TURNSTILE_SECRET_KEY=

# AdSense: replace with your approved publisher/client ID only after approval
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Public origin used for canonical links, e.g. https://cloudbox.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
